# 复制为 deploy/.env 并修改。生产环境务必替换两个密钥。
GLEANER_SECRET=change-me-to-a-long-random-string
# 32 字节十六进制：python -c "import os;print(os.urandom(32).hex())"
GLEANER_DATA_KEY=
GLEANER_MQTT_ADMIN_PASS=change-me
POSTGRES_PASSWORD=gleaner
GRAFANA_PASSWORD=gleaner

# 真实学校来源（上线时配置；开发期指向 fake_moodle）
# GLEANER_MOODLE_URL=https://moodle.example.edu
# GLEANER_COLLEGE_URL=https://cs.example.edu

# HTTPS / MQTT over TLS（Let's Encrypt 证书挂载到 deploy/certs）
# GLEANER_GATEWAY_TLS_PORT=8443
# GLEANER_MQTT_TLS_PORT=8883
# GLEANER_TLS_CERT=/certs/fullchain.pem
# GLEANER_TLS_KEY=/certs/privkey.pem

# 告警邮件收件人（经下方平台发信账号、自研 SMTP 发出）
# GLEANER_ALERT_TO=ops@example.edu

# 大模型摘要（P2，可选）：OpenAI 兼容接口，三项都填写后启用，否则使用规则提取
# GLEANER_LLM_BASE_URL=https://<服务商接口域名>
# GLEANER_LLM_MODEL=<模型名>
# GLEANER_LLM_API_KEY=

# 平台发信账号：注册验证码、每日摘要邮件、运维告警（经自研 SMTP 发出）
# GLEANER_PLATFORM_SMTP_HOST=smtp.example.com
# GLEANER_PLATFORM_SMTP_PORT=587
# GLEANER_PLATFORM_SMTP_SECURITY=starttls
# GLEANER_PLATFORM_SMTP_USER=noreply@example.com
# GLEANER_PLATFORM_SMTP_PASS=
# GLEANER_PLATFORM_MAIL_FROM=拾课 <noreply@example.com>
# 注册是否必须填写邮箱验证码（默认 1）
# GLEANER_REQUIRE_EMAIL_CODE=1
