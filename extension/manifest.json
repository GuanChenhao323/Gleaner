{
  "manifest_version": 3,
  "name": "Campus Radar",
  "version": "0.10.0",
  "description": "在插件弹窗中输入条件、提取当前网页、核对匹配片段并保存到 Campus Radar。",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "采集到 Campus Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
